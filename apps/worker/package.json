{
  "name": "@fragments/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fragments --local",
    "db:migrate:remote": "wrangler d1 migrations apply fragments --remote"
  },
  "dependencies": {
    "@fragments/server-core": "*",
    "@fragments/shared": "*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  }
}
