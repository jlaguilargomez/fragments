{
  "name": "@fragments/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:pages": "vue-tsc -b && GITHUB_PAGES=true VITE_TRIAL_MODE=true VITE_ENABLE_SIGNUP=false vite build",
    "typecheck": "vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@fragments/shared": "*",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vue-tsc": "^3.0.7"
  }
}
